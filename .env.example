DATABASE_URL=postgres://app:app@localhost:5432/persona
REDIS_URL=redis://localhost:6379
APP_BASE_URL=http://localhost:3000
# 32+ random characters; encrypts stored API keys and signs local file URLs
APP_SECRET=change-me-to-a-long-random-string

# Storage: s3 | local  (local writes to ./.data/storage, for development only)
STORAGE_DRIVER=local
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1

# Leave empty in development: emails are written to the dev mailbox at /dev/mail
EMAIL_SMTP_URL=
EMAIL_FROM=Persona <no-reply@example.com>

# Leave OPENAI_API_KEY empty to use the deterministic mock AI (development and tests)
OPENAI_API_KEY=
OPENAI_MODEL_DRAFT=gpt-4.1
OPENAI_MODEL_CLASSIFY=gpt-4.1-mini
OPENAI_MODEL_TRANSCRIBE=gpt-4o-mini-transcribe
OPENAI_MODEL_VISION=gpt-4.1-mini

EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=
EVOLUTION_WEBHOOK_SECRET=
# mock | evolution
WHATSAPP_GATEWAY=mock
DEBOUNCE_SECONDS=180
DEFAULT_TIMEZONE=Asia/Kuala_Lumpur

# Enables /dev tools (mock phone, mailbox, time travel). Never set in production.
DEV_TOOLS=1
